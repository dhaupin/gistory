{
  "name": "gistory-sync",
  "private": false,
  "version": "0.9.0",
  "description": "E2EE multi-device sync engine for prompt libraries: agent crypto, merge rules (LWW + tombstones), QoS scheduling, and the storage seam — the same code the app and its service worker run.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://gistory.creadev.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaupin/gistory.git"
  },
  "bugs": "https://github.com/dhaupin/gistory/issues",
  "keywords": [
    "prompts",
    "sync",
    "e2ee",
    "encryption",
    "offline-first",
    "local-first",
    "prompt-manager",
    "cloudflare-pages",
    "aes-gcm",
    "multi-device"
  ],
  "main": "dist/lib/index.mjs",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "//dependencies": "NONE — the published bundle is self-contained ESM. The app's UI deps (react, react-dom, react-router-dom, lucide-react, qrcode.react) live in devDependencies: the Pages/CF build and CI install dev deps too, and keeping them out of dependencies keeps `npm install gistory-sync` free of a React tree it never uses.",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "crashtest": "^1.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eyestruct": "1.0.0",
    "freestruct": "^1.1.0",
    "globals": "^15.14.0",
    "lucide-react": "^1.17.0",
    "packstruct": "1.0.0",
    "prestruct": "^1.1.0",
    "puppeteer": "^25.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && prestruct build && node scripts/build-sw.mjs",
    "build:lib": "node scripts/build-lib.mjs && tsc -p tsconfig.lib.json",
    "build:og": "node scripts/build-og.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.functions.json && tsc -p tsconfig.test.json",
    "lint": "npm run lint:eslint && npm run lint:lange && npm run lint:docs && npm run lint:version",
    "lint:version": "node scripts/check-version-truth.mjs",
    "lint:docs": "node scripts/check-docs.mjs",
    "lint:packs": "packstruct lint packs --deep",
    "lint:eslint": "eslint .",
    "lint:language": "node scripts/check-language.mjs",
    "sync:smoke": "bun tests/sync-smoke.ts",
    "sync:live": "bun scripts/live-sync.mjs",
    "sync:multidev": "bun scripts/live-multidevice.mjs",
    "sync:subscribe": "bun scripts/live-subscribe.mjs",
    "sync:barrage": "bun tests/barrage.ts",
    "crashtest:build": "node scripts/build-crashtest.mjs",
    "crashtest:run": "node scripts/build-crashtest.mjs && crashtest run",
    "framework:gate": "node scripts/framework-gate.mjs",
    "transport:lands": "node scripts/verify-transport-lands.mjs",
    "test:ui": "node tests/ui/run.mjs",
    "ui:audit": "node scripts/ui-audit.mjs",
    "probe:dist": "node scripts/dist-probe.mjs",
    "ui:browsers": "node scripts/ui-browsers.mjs",
    "db:init:local": "npx --yes wrangler d1 execute GISTORY_DB --local --file=schema.sql",
    "db:init:remote": "npx --yes wrangler d1 execute GISTORY_DB --remote --config wrangler.deploy.toml --file=schema.sql",
    "db:migrate:local": "node scripts/db-migrate.mjs --local",
    "db:migrate:remote": "npx --yes wrangler d1 execute GISTORY_DB --remote --config wrangler.deploy.toml --file=schema.sql",
    "db:migrate:status:remote": "npx --Eys wrangler d1 status GISTORY_DB --remote",
    "db:migrate:status:remote": "npx --yes wrangler d1 status GISTORY_DB --remote --status",
    "db:migrate:check": "npx --yes wrangler d1 check GISTORY_DB",
    "db:maintain:local": "node scripts/db-maintain.mjs --local",
    "db:maintain:remote": "node scripts/db-maintain.mjs --remote",
    "db:maintain:check": "node scripts/db-maintain.mjs --check",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build:lib",
    "preview": "vite preview",
    "icons:adopt": "node scripts/adopt-icons.mjs"
  }
}
