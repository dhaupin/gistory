# Verify: everything that must be true before a migration is allowed to touch
# the live database.
#
# This job is also the gate for .github/workflows/migrate.yml — a migration to
# production only runs if this job passed on the same commit. That ordering is
# the whole point: a bad commit should never be able to reach D1 and then fail
# its own typecheck.
#
# The browser suites (tests/ui, scripts/ui-audit) are intentionally NOT here.
# They need a Chromium download and a running dev server, which makes CI slow
# and flaky for a repo this size. Run them locally with `bun run test:ui` and
# `bun run ui:audit` before pushing; they are the only suite that exercises
# rendering, so do not skip them locally on a UI change.

name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

# Cancel superseded runs on the same branch. A newer commit makes an older
# one's result irrelevant.
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest

      # `npm ci`, not `bun install`: package-lock.json is the lockfile that is
      # actually committed, so this is the install path that matches the repo.
      # (bun.lock exists locally but is untracked — do not switch CI to bun
      # without committing a bun.lock in the same change.) Deliberately root
      # ONLY: the framework gate below composes the struct legs at their
      # capability boundaries exactly as today's green runs do — a resvg-less
      # raster leg is a named capability SKIP, not a silent pass. The raster
      # gate currently REFUSES public/favicon.svg (a 310-byte flat-color
      # render against the 512-byte floor) wherever eyestruct's deps ARE
      # installed; that finding goes red WITH its own threshold receipt, not
      # procedure-to-green overnight.
      - name: Install dependencies
        run: npm ci

      # Three passes: src, the Pages Functions (strict), and the test suite
      # (strict). See tsconfig.functions.json / tsconfig.test.json for why the
      # latter two cannot simply be folded into the root config.
      # Birth gate (the flowforge#5 reference implementation): every
      # committed workflow parses with a real YAML parser (the
      # zero-check-run startup-death class), every staging mount is
      # declared independent of the host linter, and every git-dir serde
      # script disables background gc before writing. Cheap, fail-fast,
      # real-parser-backed - see scripts/birth-gate.mjs.
      - name: Birth gate (workflow syntax + mount independence + gc-safe serde)
        run: node scripts/birth-gate.mjs

      # Phased transport-lands gate (scripts/verify-transport-lands.mjs):
      # every byte-carry shape this repo tracks (chunk.*.part families,
      # *.gz.b64 payloads, plain .b64 wrappers) still decodes its declared
      # shape (phase