node_modules/
dist/
.env
*.local
.wrangler/
wrangler.deploy.toml
.ui-audit/
.prestruct/

# Vant brain workspace (lives in the repo dir, travels only via horcrux/)
models/
bun.lock

# Crashtest bundle output (built before every run; see scripts/build-crashtest.mjs)
crashtest/handlers.mjs

# Eyestruct candidates are session-burned disposables (PRD receipt 3:
# only COMMITTED .eyes/ artifacts are the visual memory). The .eyes/
# tree itself rides tracked - that is the memory law.
.eyes-candidates/

# Poststruct/monoforge staging trees retired 2026-11-02: both repos
# graduated upstream (dhaupin/poststruct, dhaupin/monoforge) and own their
# own CI; gistory no longer hosts or ferries them. Their nested .git
# ignores retire with the trees.

# stone-cutting scratch (disposables never ride)
.cut-tmp/

# scratch fetch dir from the eyestruct-parity work (never project content)
.eyestruct-stage/

# Docs build products (gistory#19, eyestruct worked-example gitignore block):
# an accidental in-tree Jekyll build taints nothing. CI resolves the bundle
# fresh each run, so no Gemfile.lock is ever indexed.
docs/.bundle/
docs/vendor/
docs/_site/
docs/Gemfile.lock
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/pagefind/
docs/pagefind*
